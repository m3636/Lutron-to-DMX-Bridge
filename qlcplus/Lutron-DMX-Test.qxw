   <Step Number="1" FadeIn="4000" Hold="4000" FadeOut="0">0</Step>
   <Step Number="2" FadeIn="4000" Hold="4000" FadeOut="0">2</Step>
  </Function>
  <Function ID="31" Type="Chaser" Name="Chase: Whole house ramp 0-100-0 (10 s each way)" Path="Chases">
